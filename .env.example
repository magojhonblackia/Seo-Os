# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env a git. NUNCA pegues estos valores en el chat o en código.

# DeepSeek API — https://platform.deepseek.com (Fase 2)
DEEPSEEK_API_KEY=

# Service account de Google para Search Console API (opcional en Fase 0,
# ver README para setup). Ruta al JSON descargado de Google Cloud Console.
GOOGLE_APPLICATION_CREDENTIALS=credentials/gsc-service-account.json

# PageSpeed Insights API key (opcional, sube cuota de requests)
PAGESPEED_API_KEY=

# Bing Webmaster Tools API key — https://www.bing.com/webmasters (Fase 4).
# Requiere verificar el sitio en Bing Webmaster Tools primero.
BING_WEBMASTER_API_KEY=

# Serper.dev (Fase 5, ranking real en Google) — https://serper.dev/api-keys.
# 2500 consultas gratis, sin tarjeta. Usado por el collector de rank tracking
# para ver posición REAL en el SERP (no el promedio de Search Console) de tu
# sitio y de tus competidores. Deliberadamente NO corre en el scheduler diario
# automático — es manual, para no gastar el cupo gratis sin que lo decidas.
SERPER_API_KEY=

# Google Analytics 4 — conversiones reales por landing page (§ herramientas
# nuevas). Es el ID NUMÉRICO de la propiedad (ej. 123456789), NO el "G-XXXXXXX"
# de medición. Lo encuentras en GA4 → Administrar → Detalles de la propiedad.
# Usa el MISMO service account de Search Console: entra a GA4 → Administrar →
# Gestión de accesos a la propiedad → añade el email del service account
# (el de credentials/gsc-service-account.json) con rol de Lector.
# Sin esto, el tab Cobertura muestra "GA4 sin configurar" y nada se rompe.
GA4_PROPERTY_ID=

# IndexNow — notifica a Bing/Yandex/Seznam/Naver que una URL cambió, sin
# esperar a que la vuelvan a crawlear por su cuenta (§ herramientas de mercado
# 2026-07-24). Setup:
# 1. Genera una key: python3 -c "import secrets; print(secrets.token_hex(16))"
#    (o corre la auditoría sin esto configurado: el checker te sugiere una).
# 2. Publica un archivo en https://tu-sitio.com/<esa-key>.txt cuyo ÚNICO
#    contenido sea la key (sin comillas, sin salto de línea extra).
# 3. Pega la key aquí.
# Sin esto, el tab Cobertura muestra "IndexNow sin configurar" con los mismos
# pasos — nada se rompe. El envío a Bing/Yandex es una acción manual aparte
# (botón "Notificar cambios"), nunca automática en cada auditoría.
INDEXNOW_KEY=

# Alertas por Telegram (Fase 4). Setup:
# 1. Habla con @BotFather en Telegram, /newbot, copia el token que te da.
# 2. Escríbele un mensaje cualquiera a tu bot nuevo (para que pueda escribirte de vuelta).
# 3. Abre https://api.telegram.org/bot<TU_TOKEN>/getUpdates en el navegador y busca "chat":{"id": ...}
# Sin esto, las alertas quedan desactivadas (no se rompe nada, solo no se envían).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Token de auth (Fase 4) — SOLO necesario si vas a cambiar HOST para exponer
# esto en tu red local. Genera algo largo y aleatorio, ej:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Con HOST=127.0.0.1 (default) esto no se usa — la app ya está aislada.
AUTH_TOKEN=

# Servidor — nunca cambiar HOST a 0.0.0.0 sin agregar AUTH_TOKEN arriba primero
HOST=127.0.0.1
PORT=8000

# Ruta de la base de datos SQLite
DATABASE_PATH=data/seo.db
